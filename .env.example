# ==========================================

# Windows / 16 GB RAM: CPU int8, no CUDA or PyTorch required.
DEVICE=cpu
ASR_ENGINE=faster-whisper
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
ASR_CPU_THREADS=6
PREWARM_MODELS=False
DEBUG=False
TTS_ENGINE=edge-tts
LLM_PROVIDER=free
GEMINI_MODEL=gemini-3.8-flash
# Douyin2TikTok AI Studio Configuration
# ==========================================

# 1. AI Translation API Keys
# Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/)
GEMINI_API_KEY=

# DeepSeek API Key (nếu muốn dùng văn phong DeepSeek)
DEEPSEEK_API_KEY=

# 2. Text-to-Speech (TTS) Default Voice
# Hoài My (Nữ truyền cảm): vi-VN-HoaiMyNeural
# Nam Minh (Nam kịch tính/review): vi-VN-NamMinhNeural
EDGE_VOICE=vi-VN-HoaiMyNeural

# 3. Audio & Vocal Separation Engine
# 'realtime' runs DSP on CPU; optional 'roformer' needs separate installation.
SEPARATION_ENGINE=realtime

# 4. Chinese Subtitle Masking
MASK_CHINESE_SUBTITLE=True
SUBTITLE_FONT=Arial
