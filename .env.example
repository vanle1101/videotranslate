# ==========================================

# Windows / 16 GB RAM: CPU int8, no CUDA or PyTorch required.
DEVICE=cpu
ASR_ENGINE=faster-whisper
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
ASR_CPU_THREADS=6
PREWARM_MODELS=False
DEBUG=False
TTS_ENGINE=edge-tts
LLM_PROVIDER=openrouter-free
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-sante:free
OPENCODE_MODEL=big-pickle
OPENCODE_TIMEOUT=60
GEMINI_MODEL=gemini-2.5-flash
# existing: connect the running Chrome after its user enables remote debugging.
# dedicated: separate Chrome profile, sign in once inside that profile.
MUSE_BROWSER_MODE=dedicated
# 0: automatic; or local port shown by your chosen Chrome (for example 9222).
MUSE_CHROME_PORT=0
# Douyin2TikTok AI Studio Configuration
# ==========================================

# 1. AI Translation API Keys
# OpenCode login reuse: reads OpenRouter-Free/openrouter and opencode entries
# from ~/.local/share/opencode/auth.json. OpenRouter Free is the default.
# Optional override below; keep the real key only in your ignored local .env.
OPENCODE_API_KEY=
OPENROUTER_API_KEY=

# Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/)
GEMINI_API_KEY=

# DeepSeek API Key (nếu muốn dùng văn phong DeepSeek)
DEEPSEEK_API_KEY=

# 2. Text-to-Speech (TTS) Default Voice
# Hoài My (Nữ truyền cảm): vi-VN-HoaiMyNeural
# Nam Minh (Nam kịch tính/review): vi-VN-NamMinhNeural
EDGE_VOICE=vi-VN-HoaiMyNeural

# 3. Audio & Vocal Separation Engine
# 'realtime' runs DSP on CPU; optional 'roformer' needs separate installation.
SEPARATION_ENGINE=realtime

# 4. Chinese Subtitle Masking
MASK_CHINESE_SUBTITLE=True
SUBTITLE_FONT=Arial
