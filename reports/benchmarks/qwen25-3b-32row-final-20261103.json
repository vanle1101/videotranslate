      "translations": [
        {
          "id": 0,
          "source_zh": "一个家庭一个孩子不就够了吗",
          "final_vi": "Một gia đình có một đứa con chẳng phải là đủ rồi sao?"
        },
        {
          "id": 1,
          "source_zh": "小元是哥哥了",
          "final_vi": "Tiểu Nguyên là anh rồi."
        },
        {
          "id": 2,
          "source_zh": "你看妹妹多可爱啊",
          "final_vi": "Này, em gái nó thật đáng yêu"
        },
        {
          "id": 3,
          "source_zh": "是啊,爸爸,他好可爱",
          "final_vi": "Đúng vậy bố, bé thật đáng yêu"
        },
        {
          "id": 4,
          "source_zh": "真丑 没见过这么丑的孩子",
          "final_vi": "Thật xấu xa, chưa từng thấy đứa bé xấu đến vậy"
        },
        {
          "id": 5,
          "source_zh": "像眉毛的小猫",
          "final_vi": "Như một con mèo có lông mày"
        },
        {
          "id": 6,
          "source_zh": "护士您好",
          "final_vi": "Chào y tá"
        },
        {
          "id": 7,
          "source_zh": "孩子还有多久才能出来",
          "final_vi": "Em bé còn bao lâu nữa mới chào đời?"
        },
        {
          "id": 8,
          "source_zh": "孩子妈妈特别想他",
          "final_vi": "Mẹ con bé/con rất nhớ bé"
        },
        {
          "id": 9,
          "source_zh": "再过三天",
          "final_vi": "Còn ba ngày nữa"
        },
        {
          "id": 10,
          "source_zh": "各项指标稳定就可以了",
          "final_vi": "Các chỉ số đều ổn định"
        },
        {
          "id": 11,
          "source_zh": "太好了",
          "final_vi": "Tốt quá"
        },
        {
          "id": 12,
          "source_zh": "谢谢",
          "final_vi": "Cảm ơn"
        },
        {
          "id": 13,
          "source_zh": "谢谢",
          "final_vi": "Cảm ơn"
        },
        {
          "id": 14,
          "source_zh": "儿子 听到没有",
          "final_vi": "Con trai, nghe chưa?"
        },
        {
          "id": 15,
          "source_zh": "你妹妹就快回家了",
          "final_vi": "Em gái sắp về nhà rồi đó"
        },
        {
          "id": 16,
          "source_zh": "嗯 听到了",
          "final_vi": "Đã nghe"
        },
        {
          "id": 17,
          "source_zh": "可恶的闯入者",
          "final_vi": "Con người đáng ghét này"
        },
        {
          "id": 18,
          "source_zh": "原本属于我一个人的",
          "final_vi": "Đây vốn là của tôi một mình"
        },
        {
          "id": 19,
          "source_zh": "都要称分给他",
          "final_vi": "Nên chia đều cho anh ấy"
        },
        {
          "id": 20,
          "source_zh": "给我看看女儿的录像",
          "final_vi": "Xem video của con gái đi"
        },
        {
          "id": 21,
          "source_zh": "你看她多小啊",
          "final_vi": "Này, nhìn cô bé nhỏ thế nào"
        },
        {
          "id": 22,
          "source_zh": "多可愛啊",
          "final_vi": "Đáng yêu thế nào"
        },
        {
          "id": 23,
          "source_zh": "鼻子像你",
          "final_vi": "Nét mũi giống anh"
        },
        {
          "id": 24,
          "source_zh": "小冤",
          "final_vi": "Tiểu Nguyên"
        },
        {
          "id": 25,
          "source_zh": "来 爸看看 疼不疼",
          "final_vi": "Đến, bác sĩ xem cho đau không"
        },
        {
          "id": 26,
          "source_zh": "现在我赢了",
          "final_vi": "Bây giờ tôi thắng rồi"
        },
        {
          "id": 27,
          "source_zh": "所有人都看我了",
          "final_vi": "Người ta nhìn tôi"
        },
        {
          "id": 28,
          "source_zh": "来",
          "final_vi": "Đến"
        },
        {
          "id": 29,
          "source_zh": "再看看妹妹",
          "final_vi": "Xem lại em gái"
        },
        {
          "id": 30,
          "source_zh": "她是不是比在医院时更好看了",
          "final_vi": "Em ấy có phải không đẹp hơn lúc ở bệnh viện không"
        },
        {
          "id": 31,
          "source_zh": "不難看了",
          "final_vi": "Không đẹp hơn nữa"
        }
      ]
    }
  ],
