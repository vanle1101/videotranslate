      "translations": [
        {
          "id": 0,
          "source_zh": "一个家庭一个孩子不就够了吗",
          "final_vi": "Đã đủ một gia đình có một đứa con chưa?"
        },
        {
          "id": 1,
          "source_zh": "小元是哥哥了",
          "final_vi": "Anh là anh trai rồi"
        },
        {
          "id": 2,
          "source_zh": "你看妹妹多可爱啊",
          "final_vi": "Em gái này thật đáng yêu"
        },
        {
          "id": 3,
          "source_zh": "是啊,爸爸,他好可爱",
          "final_vi": "Đúng vậy bố, bé thật đáng yêu"
        },
        {
          "id": 4,
          "source_zh": "真丑 没见过这么丑的孩子",
          "final_vi": "Thật xấu xí, chưa từng thấy đứa bé xấu đến vậy"
        },
        {
          "id": 5,
          "source_zh": "像眉毛的小猫",
          "final_vi": "Như một con mèo có lông mày"
        },
        {
          "id": 6,
          "source_zh": "护士您好",
          "final_vi": "Chào cô y tá"
        },
        {
          "id": 7,
          "source_zh": "孩子还有多久才能出来",
          "final_vi": "Em bé còn bao lâu nữa mới chào đời"
        },
        {
          "id": 8,
          "source_zh": "孩子妈妈特别想他",
          "final_vi": "Mẹ rất nhớ bé"
        },
        {
          "id": 9,
          "source_zh": "再过三天",
          "final_vi": "Còn ba ngày nữa"
        },
        {
          "id": 10,
          "source_zh": "各项指标稳定就可以了",
          "final_vi": "Các chỉ số đều ổn định"
        },
        {
          "id": 11,
          "source_zh": "太好了",
          "final_vi": "Tất cả đều tốt quá"
        },
        {
          "id": 12,
          "source_zh": "谢谢",
          "final_vi": "Cảm ơn"
        },
        {
          "id": 13,
          "source_zh": "谢谢",
          "final_vi": "Cảm ơn"
        },
        {
          "id": 14,
          "source_zh": "儿子 听到没有",
          "final_vi": "Con trai, nghe chưa?"
        },
        {
          "id": 15,
          "source_zh": "你妹妹就快回家了",
          "final_vi": "Em gái con sắp về nhà rồi đó"
        }
      ]
    }
