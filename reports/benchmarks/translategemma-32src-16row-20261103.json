      "translations": [
        {
          "id": 0,
          "source_zh": "一个家庭一个孩子不就够了吗",
          "final_vi": "Một gia đình, một đứa trẻ, có cần thêm nữa không"
        },
        {
          "id": 1,
          "source_zh": "小元是哥哥了",
          "final_vi": "Tiểu Nguyên đã lớn hơn"
        },
        {
          "id": 2,
          "source_zh": "你看妹妹多可爱啊",
          "final_vi": "Em bé này dễ thương quá, bạn ơi"
        },
        {
          "id": 3,
          "source_zh": "是啊,爸爸,他好可爱",
          "final_vi": "Ừ, bố, con rất dễ thương"
        },
        {
          "id": 4,
          "source_zh": "真丑 没见过这么丑的孩子",
          "final_vi": "Con thật xấu, chưa từng thấy con nào xấu như vậy."
        },
        {
          "id": 5,
          "source_zh": "像眉毛的小猫",
          "final_vi": "Như một chú mèo nhỏ trên lông mày"
        },
        {
          "id": 6,
          "source_zh": "护士您好",
          "final_vi": "Cô y tá, chào bạn."
        },
        {
          "id": 7,
          "source_zh": "孩子还有多久才能出来",
          "final_vi": "Còn bao lâu nữa đứa bé sẽ ra đời?"
        },
        {
          "id": 8,
          "source_zh": "孩子妈妈特别想他",
          "final_vi": "Mẹ muốn con đến rất nhiều."
        },
        {
          "id": 9,
          "source_zh": "再过三天",
          "final_vi": "Khoảng ba ngày nữa"
        },
        {
          "id": 10,
          "source_zh": "各项指标稳定就可以了",
          "final_vi": "Các chỉ số ổn định là được"
        },
        {
          "id": 11,
          "source_zh": "太好了",
          "final_vi": "Tuyệt vời"
        },
        {
          "id": 12,
          "source_zh": "谢谢",
          "final_vi": "Cảm ơn"
        },
        {
          "id": 13,
          "source_zh": "谢谢",
          "final_vi": "Cảm ơn"
        },
        {
          "id": 14,
          "source_zh": "儿子 听到没有",
          "final_vi": "Con có nghe không?"
        },
        {
          "id": 15,
          "source_zh": "你妹妹就快回家了",
          "final_vi": "Em gái của bạn sắp về nhà rồi."
        }
      ]
    }
