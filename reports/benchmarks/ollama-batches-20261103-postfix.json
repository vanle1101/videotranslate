      "translations": [
        {
          "id": 0,
          "source_zh": "一个家庭一个孩子不就够了吗",
          "final_vi": "Một gia đình có một đứa con chẳng phải là đủ rồi sao?"
        },
        {
          "id": 1,
          "source_zh": "小元是哥哥了",
          "final_vi": "Tiểu Nguyên là anh trai rồi"
        },
        {
          "id": 2,
          "source_zh": "你看妹妹多可爱啊",
          "final_vi": "Mẹ ơi, em gái này quá đáng yêu rồi!"
        },
        {
          "id": 3,
          "source_zh": "是啊,爸爸,他好可爱",
          "final_vi": "Đúng vậy bố, bé đáng yêu quá"
        },
        {
          "id": 4,
          "source_zh": "真丑 没见过这么丑的孩子",
          "final_vi": "Thật là xấu, chưa từng thấy trẻ xấu như thế"
        },
        {
          "id": 5,
          "source_zh": "像眉毛的小猫",
          "final_vi": "Mắt mèo nhỏ"
        },
        {
          "id": 6,
          "source_zh": "护士您好",
          "final_vi": "Chào cô y tá"
        },
        {
          "id": 7,
          "source_zh": "孩子还有多久才能出来",
          "final_vi": "Bé còn bao lâu nữa mới chào đời?"
        },
        {
          "id": 8,
          "source_zh": "孩子妈妈特别想他",
          "final_vi": "Mẹ nhớ bé lắm"
        },
        {
          "id": 9,
          "source_zh": "再过三天",
          "final_vi": "Còn ba ngày nữa"
        },
        {
          "id": 10,
          "source_zh": "各项指标稳定就可以了",
          "final_vi": "Các chỉ số ổn định là được"
        },
        {
          "id": 11,
          "source_zh": "太好了",
          "final_vi": "Tốt rồi"
        },
        {
          "id": 12,
          "source_zh": "谢谢",
          "final_vi": "Cảm ơn"
        },
        {
          "id": 13,
          "source_zh": "谢谢",
          "final_vi": "Cảm ơn"
        },
        {
          "id": 14,
          "source_zh": "儿子 听到没有",
          "final_vi": "Con nghe chưa?"
        },
        {
          "id": 15,
          "source_zh": "你妹妹就快回家了",
          "final_vi": "Em gái con sắp về nhà rồi"
        }
      ]
    },
