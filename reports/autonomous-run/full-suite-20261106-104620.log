e">\\n              <div id="player-container">\\n                <video id="video-player" playsinline></video>\\n                <div id="chinese-sub-mask" class="absolute bottom-16 left-0 right-0 h-14 bg-black/65 backdrop-blur-md pointer-events-none transition-opacity duration-300"></div>\\n                <div id="subtitle-overlay" class="absolute bottom-16 left-4 right-4 text-center pointer-events-none z-10"><span id="subtitle-text"></span></div>\\n                <div id="screen-text-overlay" class="screen-text-overlay" aria-hidden="true"></div>\\n                <div id="buffering-alert" role="status" aria-live="polite" class="hidden player-buffering-overlay">\\n                  <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>\\n                  <p id="buffering-text">\u0110ang t\u1ea3i gi\u1ecdng l\u1ed3ng ti\u1ebfng...</p>\\n                  <div id="player-download-progress" class="player-download-progress hidden" aria-live="polite">\\n                    <div class="player-progress-heading"><strong id="player-progress-value">Ch\u01b0a c\xf3 %</strong><span id="player-progress-detail">\u0110ang ch\u1edd s\u1ed1 li\u1ec7u t\u1eeb m\xe1y ch\u1ee7\u2026</span></div>\\n                    <div id="player-progress-track" class="player-progress-track" role="progressbar" aria-label="Ti\u1ebfn \u0111\u1ed9 t\u1ea3i video" aria-valuemin="0" aria-valuemax="100"><div id="player-progress-bar" class="player-progress-bar"></div></div>\\n                  </div>\\n                </div>\\n                <div id="player-placeholder" class="player-placeholder"><img class="empty-video-art" src="/static/studio-empty.svg" alt=""><p>Ch\u01b0a c\xf3 video \u0111\u01b0\u1ee3c n\u1ea1p</p><span>D\xe1n link Douyin/TikTok ho\u1eb7c t\u1ea3i video t\u1eeb m\xe1y t\xednh \u0111\u1ec3 b\u1eaft \u0111\u1ea7u d\u1ecbch v\xe0 l\u1ed3ng ti\u1ebfng.</span><div class="preview-features" aria-hidden="true"><span><i class="fa-solid fa-film"></i>Nhi\u1ec1u \u0111\u1ecbnh d\u1ea1ng</span><span><i class="fa-regular fa-circle-play"></i>Xem tr\u01b0\u1edbc tr\u1ef1c ti\u1ebfp</span><span><i class="fa-solid fa-font"></i>Ch\u1ec9nh ph\u1ee5 \u0111\u1ec1</span><span><i class="fa-solid fa-volume-high"></i>Gi\u1ecdng l\u1ed3ng ti\u1ebfng</span></div></div>\\n              </div>\\n            </div>\\n            <p id="player-task-status" class="player-task-status hidden" role="status"></p>\\n            <div class="player-transport">\\n              <div id="segments-timeline-track" role="slider" tabindex="0" aria-label="V\u1ecb tr\xed ph\xe1t video" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0"><div id="playback-head-marker" style="left: 0%;"></div></div>\\n              <div class="player-transport-row">\\n                <button id="player-seek-backward" class="player-seek" type="button" aria-label="L\xf9i 5 gi\xe2y" title="L\xf9i 5 gi\xe2y"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i><span aria-hidden="true">5</span></button>\\n                <button id="player-play-toggle" type="button" aria-label="Ph\xe1t video" title="Ph\xe1t / t\u1ea1m d\u1eebng"><i class="fa-solid fa-play" aria-hidden="true"></i></button>\\n                <button id="player-seek-forward" class="player-seek" type="button" aria-label="Ti\u1ebfn 5 gi\xe2y" title="Ti\u1ebfn 5 gi\xe2y"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i><span aria-hidden="true">5</span></button>\\n                <span class="player-time"><span id="bar-current-time">00:00</span><span class="player-time-divider">/</span><span id="bar-total-time">00:00</span></span>\\n                <span id="bar-buffer-info" class="player-buffer-info">Buffer: 0.0s</span>\\n                <button id="player-mute-toggle" type="button" aria-label="T\u1eaft ti\u1ebfng video" title="B\u1eadt / t\u1eaft ti\u1ebfng"><i class="fa-solid fa-volume-high" aria-hidden="true"></i></button>\\n                <input id="player-volume" type="range" min="0" max="1" step="0.05" value="1" aria-label="\xc2m l\u01b0\u1ee3ng video">\\n                <button id="player-fullscreen" type="button" aria-label="Xem video to\xe0n m\xe0n h\xecnh" title="To\xe0n m\xe0n h\xecnh"><i class="fa-solid fa-expand" aria-hidden="true"></i></button>\\n                <button id="player-settings" type="button" aria-label="M\u1edf c\xe0i \u0111\u1eb7t ph\xe1t v\xe0 x\u1eed l\xfd" title="C\xe0i \u0111\u1eb7t"><i class="fa-solid fa-gear" aria-hidden="true"></i></button>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n        <div class="studio-splitter" data-layout-axis="y" data-layout-index="0" role="separator" tabindex="0" aria-orientation="horizontal" aria-controls="studio-player caption-style-panel" aria-label="Chi\u1ec1u cao video v\xe0 ch\u1ec9nh ph\u1ee5 \u0111\u1ec1" title="K\xe9o \u0111\u1ec3 \u0111\u1ed5i k\xedch th\u01b0\u1edbc; d\xf9ng ph\xedm m\u0169i t\xean khi ch\u1ecdn \u0111\u01b0\u1eddng chia"></div>\\n        <details id="caption-style-panel" class="caption-style-panel" open>\\n          <summary>Ch\u1ec9nh ph\u1ee5 \u0111\u1ec1 <span>N\u1ec1n \xb7 font \xb7 c\u1ee1 ch\u1eef \xb7 v\u1ecb tr\xed</span></summary>\\n          <fieldset id="caption-style-controls" disabled aria-describedby="caption-style-availability caption-style-status">\\n            <div class="caption-style-grid">\\n              <label>M\xe0u ch\u1eef<input id="caption-text-color" type="color" value="#000000" aria-label="M\xe0u ch\u1eef ph\u1ee5 \u0111\u1ec1"></label>\\n              <label>M\xe0u n\u1ec1n<input id="caption-background-color" type="color" value="#FFE500" aria-label="M\xe0u n\u1ec1n ph\u1ee5 \u0111\u1ec1"></label>\\n              <label>V\u1ecb tr\xed<select id="caption-position"><option value="auto">T\u1ef1 \u0111\u1ed9ng</option><option value="top">Ph\xeda tr\xean</option><option value="middle">\u1ede gi\u1eefa</option><option value="bottom">Ph\xeda d\u01b0\u1edbi</option></select></label>\\n            </div>\\n            <div class="caption-typography-grid">\\n              <label class="caption-font-control" for="caption-font-family">Font ch\u1eef<select id="caption-font-family"><option value="Arial" style="font-family:Arial,sans-serif">Arial</option><option value="Segoe UI" style="font-family:\\'Segoe UI\\',sans-serif">Segoe UI</option><option value="Tahoma" style="font-family:Tahoma,sans-serif">Tahoma</option><option value="Verdana" style="font-family:Verdana,sans-serif">Verdana</option><option value="Times New Roman" style="font-family:\\'Times New Roman\\',serif">Times New Roman</option></select></label>\\n              <div class="caption-size-control"><label for="caption-font-size-pt">C\u1ee1 ch\u1eef</label><span class="caption-point-input"><input id="caption-font-size-pt" type="number" list="caption-font-sizes" min="6" max="96" step="0.5" placeholder="T\u1ef1 \u0111\u1ed9ng" aria-label="C\u1ee1 ch\u1eef ph\u1ee5 \u0111\u1ec1 theo point, t\u1eeb 6 \u0111\u1ebfn 96"><span aria-hidden="true">pt</span></span><button id="caption-font-size-auto" class="caption-auto-size" type="button" aria-pressed="true" title="T\u1ef1 c\u0103n c\u1ee1 ch\u1eef theo video v\xe0 \u0111\u1ed9 d\xe0i c\xe2u">T\u1ef1 \u0111\u1ed9ng</button><label class="caption-bold-button" title="Ch\u1eef \u0111\u1eadm"><input id="caption-font-bold" type="checkbox" checked aria-label="Ch\u1eef \u0111\u1eadm ph\u1ee5 \u0111\u1ec1"><span aria-hidden="true">B</span></label></div>\\n              <datalist id="caption-font-sizes"><option value="8"></option><option value="9"></option><option value="10"></option><option value="11"></option><option value="12"></option><option value="14"></option><option value="16"></option><option value="18"></option><option value="20"></option><option value="24"></option><option value="28"></option><option value="32"></option><option value="36"></option><option value="48"></option><option value="72"></option><option value="96"></option></datalist>\\n              <div hidden class="hidden" aria-hidden="true"><input id="caption-font-scale" type="range" min="50" max="200" step="1" value="100" tabindex="-1"><input id="caption-font-scale-number" type="number" min="50" max="200" step="1" value="100" tabindex="-1"></div>\\n              <div class="caption-opacity-control"><label for="caption-background-opacity">\u0110\u1ed9 \u0111\u1eadm n\u1ec1n</label><input id="caption-background-opacity" type="range" min="0" max="100" step="1" value="100" aria-label="\u0110\u1ed9 \u0111\u1eadm n\u1ec1n ph\u1ee5 \u0111\u1ec1"><output id="caption-background-opacity-value" for="caption-background-opacity">100%</output></div>\\n            </div>\\n            <div class="caption-style-options">\\n              <label title="D\xf9ng n\u1ec1n v\xe0ng th\u1ed1ng nh\u1ea5t cho t\u1ea5t c\u1ea3 c\xe2u; b\u1ecf ch\u1ecdn \u0111\u1ec3 ch\u1ecdn m\xe0u kh\xe1c."><input id="caption-auto-background" type="checkbox" checked> D\xf9ng n\u1ec1n m\u1eb7c \u0111\u1ecbnh (v\xe0ng)</label>\\n              <label title="B\u1ecf n\u1ec1n ph\u1ee5 \u0111\u1ec1, gi\u1eef ch\u1eef v\xe0 v\xf9ng l\xe0m m\u1edd sub g\u1ed1c n\u1ebfu \u0111\xe3 b\u1eadt"><input id="caption-transparent-background" type="checkbox"> N\u1ec1n trong su\u1ed1t</label>\\n              <label title="Vi\u1ec1n t\u01b0\u01a1ng ph\u1ea3n gi\xfap \u0111\u1ecdc r\xf5 tr\xean n\u1ec1n trong su\u1ed1t"><input id="caption-font-outline" type="checkbox"> Vi\u1ec1n ch\u1eef</label>\\n              <label title="Ch\u1ec9 l\xe0m m\u1edd v\xf9ng ph\u1ee5 \u0111\u1ec1 g\u1ed1c \u0111\xe3 nh\u1eadn di\u1ec7n"><input id="caption-blur-original" type="checkbox"> L\xe0m m\u1edd sub g\u1ed1c</label>\\n              <button id="caption-style-reset" type="button">M\u1eb7c \u0111\u1ecbnh</button>\\n            </div>\\n          </fieldset>\\n          <p id="caption-style-availability" class="mt-2 text-[10px] leading-relaxed text-slate-300" role="status" aria-live="polite">M\u1edf d\u1ef1 \xe1n \u0111\xe3 d\u1ecbch ho\u1eb7c t\u1ea1o b\u1ea3n xem tr\u01b0\u1edbc c\xf3 gi\u1ecdng Vi\u1ec7t \u0111\u1ec3 ch\u1ec9nh ph\u1ee5 \u0111\u1ec1.</p>\\n          <p id="caption-style-status" role="status" aria-live="polite">Ki\u1ec3u ph\u1ee5 \u0111\u1ec1 \u0111\u01b0\u1ee3c l\u01b0u cho b\u1ea3n xem tr\u01b0\u1edbc v\xe0 video xu\u1ea5t.</p>\\n        </details>\\n        <div class="studio-splitter" data-layout-axis="y" data-layout-index="1" role="separator" tabindex="0" aria-orientation="horizontal" aria-controls="caption-style-panel studio-audio" aria-label="Chi\u1ec1u cao ph\u1ee5 \u0111\u1ec1 v\xe0 \xe2m thanh" title="K\xe9o \u0111\u1ec3 \u0111\u1ed5i k\xedch th\u01b0\u1edbc; d\xf9ng ph\xedm m\u0169i t\xean khi ch\u1ecdn \u0111\u01b0\u1eddng chia"></div>\\n        <section id="studio-audio" class="studio-audio-panel" aria-labelledby="audio-heading">\\n          <h3 id="audio-heading"><i class="fa-solid fa-headphones" aria-hidden="true"></i>\u0110i\u1ec1u ch\u1ec9nh \xe2m thanh</h3>\\n          <div class="audio-mixers">\\n            <div class="audio-mixer"><i class="fa-solid fa-microphone-lines" aria-hidden="true"></i><label for="vol-dub">Gi\u1ecdng Vi\u1ec7t</label><input type="range" id="vol-dub" min="0" max="1" step="0.05" value="1.0"><span id="vol-dub-val">100%</span></div>\\n            <div class="audio-mixer audio-mixer-bgm"><i class="fa-solid fa-music" aria-hidden="true"></i><label for="vol-bgm">BGM & SFX</label><input type="range" id="vol-bgm" min="0" max="1" step="0.05" value="0.30"><span id="vol-bgm-val">30%</span></div>\\n          </div>\\n          <div class="audio-suppression"><i class="fa-solid fa-wave-square" aria-hidden="true"></i><span>L\u1ecdc tho\u1ea1i Trung:</span><strong id="player-suppression-badge" title="M\u1ee9c gi\u1ea3m \u01b0\u1edbc t\xednh c\u1ee7a b\u1ed9 l\u1ecdc">--</strong><span class="audio-divider">|</span><span class="audio-bgm-label"><i class="fa-solid fa-music" aria-hidden="true"></i> BGM:</span><span id="player-bgm-status">Ch\u01b0a c\xf3</span></div>\\n        </section>\\n      </section>\\n        <div class="studio-splitter" data-layout-axis="x" data-layout-index="1" role="separator" tabindex="0" aria-orientation="vertical" aria-controls="studio-middle studio-right" aria-label="Chi\u1ec1u r\u1ed9ng c\u1ed9t video v\xe0 c\u1ed9t transcript" title="K\xe9o \u0111\u1ec3 \u0111\u1ed5i k\xedch th\u01b0\u1edbc; d\xf9ng ph\xedm m\u0169i t\xean khi ch\u1ecdn \u0111\u01b0\u1eddng chia"></div>\\n      <aside id="studio-right" class="studio-sidebar studio-column" data-layout-group="right" aria-label="Transcript, d\u1ecbch v\xe0 tr\u1ea1ng th\xe1i x\u1eed l\xfd">\\n        <section id="studio-transcript" class="transcript-panel studio-card" aria-labelledby="transcript-heading">\\n          <div class="transcript-heading"><h2 id="transcript-heading"><i class="fa-regular fa-file-lines" aria-hidden="true"></i>Transcript</h2><span id="segments-count-badge" class="transcript-count">0 c\xe2u</span><p>B\u1ea5m v\xe0o c\xe2u \u0111\u1ec3 tua video. B\u1ea5m b\u1ea3n d\u1ecbch \u0111\u1ec3 s\u1eeda t\u1eebng ch\u1eef.</p></div>\\n          <div class="transcript-toolbar"><label class="transcript-follow"><input id="transcript-follow" type="checkbox" checked> Theo v\u1ecb tr\xed ph\xe1t</label><label class="transcript-option"><input id="transcript-show-time" type="checkbox" checked> Hi\u1ec7n th\u1eddi gian</label><span class="transcript-time-note">Theo c\xe2u</span></div>\\n          <div id="segments-list" class="transcript-list" aria-label="C\xe2u tho\u1ea1i g\u1ed1c v\xe0 b\u1ea3n d\u1ecbch" tabindex="0"><div class="transcript-empty"><i class="fa-regular fa-file-lines" aria-hidden="true"></i><p>Ch\u01b0a c\xf3 n\u1ed9i dung transcript</p><span>N\u1ea1p video v\xe0 b\u1eaft \u0111\u1ea7u d\u1ecbch \u0111\u1ec3 xem, s\u1eeda v\xe0 nghe l\u1ea1i c\u1ea1nh khung h\xecnh.</span></div></div>\\n          <p id="transcript-status" class="transcript-status" role="status" aria-live="polite">B\u1ea3n s\u1eeda s\u1ebd c\u1eadp nh\u1eadt ph\u1ee5 \u0111\u1ec1 v\xe0 t\u1ea1o l\u1ea1i gi\u1ecdng \u0111\u1ecdc, gi\u1eef nguy\xean m\u1ed1c th\u1eddi gian.</p>\\n        </section>\\n        <div class="studio-splitter" data-layout-axis="y" data-layout-index="0" role="separator" tabindex="0" aria-orientation="horizontal" aria-controls="studio-transcript studio-action" aria-label="Chi\u1ec1u cao transcript v\xe0 ph\u1ea7n d\u1ecbch" title="K\xe9o \u0111\u1ec3 \u0111\u1ed5i k\xedch th\u01b0\u1edbc; d\xf9ng ph\xedm m\u0169i t\xean khi ch\u1ecdn \u0111\u01b0\u1eddng chia"></div>\\n        <section id="studio-action" class="studio-action-card studio-card" aria-labelledby="action-heading">\\n          <h2 id="action-heading" class="studio-card-heading"><i class="fa-solid fa-microphone-lines" aria-hidden="true"></i>3. D\u1ecbch v\xe0 l\u1ed3ng ti\u1ebfng</h2>\\n          <div class="buffer-setting"><label for="start-translation-workers">Lu\u1ed3ng d\u1ecbch video n\xe0y</label><select id="start-translation-workers" aria-describedby="start-translation-workers-help">\\n            <option value="1" >1 lu\u1ed3ng</option><option value="3" >3 lu\u1ed3ng</option><option value="5" >5 lu\u1ed3ng</option><option value="10" >10 lu\u1ed3ng</option><option value="15" >15 lu\u1ed3ng</option><option value="20" selected>20 lu\u1ed3ng</option><option value="30" >30 lu\u1ed3ng</option><option value="40" >40 lu\u1ed3ng</option><option value="50" >50 lu\u1ed3ng</option>\\n          </select></div>\\n          <p id="start-translation-workers-help" class="task-progress-detail">M\u1eb7c \u0111\u1ecbnh 20. \xc1p d\u1ee5ng khi b\u1eaft \u0111\u1ea7u video m\u1edbi; d\u1ef1 \xe1n m\u1edf l\u1ea1i gi\u1eef s\u1ed1 lu\u1ed3ng \u0111\xe3 l\u01b0u.</p>\\n          <div class="studio-primary-actions" role="group" aria-label="D\u1ecbch v\xe0 l\u01b0u video">\\n            <button id="btn-start" class="studio-start-button"><i class="fa-solid fa-play" aria-hidden="true"></i>B\u1eaft \u0111\u1ea7u d\u1ecbch</button>\\n            <button id="btn-retry-worker" class="hidden" title="Ti\u1ebfp t\u1ee5c t\xe1c v\u1ee5 t\u1eeb ph\u1ea7n \u0111\xe3 l\u01b0u" aria-label="Ti\u1ebfp t\u1ee5c t\xe1c v\u1ee5"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i> Ti\u1ebfp t\u1ee5c</button>\\n            <button id="btn-export-hq" aria-label="Xu\u1ea5t video MP4" disabled title="Xu\u1ea5t video t\u1eeb l\u1eddi v\xe0 gi\u1ecdng hi\u1ec7n \u0111\xe3 l\u01b0u" class="studio-export-button"><i class="fa-solid fa-arrow-up-from-bracket" aria-hidden="true"></i>Xu\u1ea5t MP4</button>\\n            <button id="btn-save-result" class="studio-export-button" disabled title="C\xf3 th\u1ec3 l\u01b0u sau khi xu\u1ea5t xong to\xe0n b\u1ed9 video"><i class="fa-solid fa-download" aria-hidden="true"></i>T\u1ea3i video</button>\\n            <button id="btn-pause-worker" class="hidden"><i class="fa-solid fa-pause" aria-hidden="true"></i> T\u1ea1m d\u1eebng</button>\\n            <button id="btn-resume-worker" class="hidden"><i class="fa-solid fa-play" aria-hidden="true"></i> Ti\u1ebfp t\u1ee5c</button>\\n            <button id="btn-stop-worker" class="hidden"><i class="fa-solid fa-stop" aria-hidden="true"></i> D\u1eebng h\u1eb3n</button>\\n          <button id="btn-translate-full" class="studio-start-button hidden" type="button"><i class="fa-solid fa-forward-step" aria-hidden="true"></i>D\u1ecbch to\xe0n b\u1ed9</button>\\n            <button id="btn-review-worker" class="hidden"><i class="fa-solid fa-check-double" aria-hidden="true"></i> AI ki\u1ec3m tra l\u1ea1i</button>\\n          </div>\\n          <div class="studio-action-options">\\n          <label class="visual-translation-option" title="\u0110\u1ed1i chi\u1ebfu l\u1eddi n\xf3i v\u1edbi ch\u1eef tr\xean video, r\u1ed3i t\u1ef1 r\xe0 v\xe0 s\u1eeda b\u1ea3n d\u1ecbch tr\u01b0\u1edbc khi t\u1ea1o gi\u1ecdng."><input id="visual-translation" type="checkbox" aria-describedby="visual-translation-help" ><span>AI ki\u1ec3m tra b\u1ea3n d\u1ecbch</span></label>\\n          <span id="visual-translation-help" class="sr-only">\u0110\u1ed1i chi\u1ebfu l\u1eddi n\xf3i v\u1edbi ch\u1eef tr\xean video, r\u1ed3i t\u1ef1 r\xe0 v\xe0 s\u1eeda b\u1ea3n d\u1ecbch tr\u01b0\u1edbc khi t\u1ea1o gi\u1ecdng.</span>\\n          <div class="buffer-setting"><label for="buffer-select">\u0110\u1ec7m tr\u01b0\u1edbc khi ph\xe1t</label><select id="buffer-select"><option value="5">5 gi\xe2y (Nhanh nh\u1ea5t)</option><option value="10" selected>10 gi\xe2y (Khuy\xean d\xf9ng)</option><option value="15">15 gi\xe2y (\u1ed4n \u0111\u1ecbnh)</option><option value="30">30 gi\xe2y (An to\xe0n)</option></select></div>\\n          </div>\\n          <div id="task-progress" class="hidden task-progress" aria-label="Ti\u1ebfn \u0111\u1ed9 x\u1eed l\xfd video">\\n            <p id="task-activity" class="task-activity" role="status" aria-live="polite">\u0110ang ki\u1ec3m tra tr\u1ea1ng th\xe1i x\u1eed l\xfd</p>\\n            <p id="task-activity-age" class="hidden task-activity-age"></p>\\n            <p id="task-countdown" class="task-countdown" role="timer">Th\u1eddi gian c\xf2n l\u1ea1i: ch\u01b0a \u0111\u1ee7 d\u1eef li\u1ec7u</p>\\n            <div class="task-progress-heading" role="status" aria-live="polite"><span id="task-progress-stage">\u0110ang g\u1eedi y\xeau c\u1ea7u\u2026</span><span class="flex flex-wrap items-baseline justify-end gap-x-2"><span id="task-progress-value">Ch\u01b0a c\xf3 %</span><span id="task-progress-eta" class="hidden text-gray-400"></span></span></div>\\n            <div id="task-progress-track" class="task-progress-track" role="progressbar" aria-label="Ti\u1ebfn \u0111\u1ed9 b\u01b0\u1edbc hi\u1ec7n t\u1ea1i" aria-valuemin="0" aria-valuemax="100"><div id="task-progress-bar" class="task-progress-bar"></div></div>\\n            <p id="task-media-progress" class="hidden task-media-progress"></p>\\n            <p id="task-progress-detail" class="task-progress-detail">Ph\u1ea7n tr\u0103m \u0111\u01b0\u1ee3c t\xednh ri\xeang cho t\u1eebng b\u01b0\u1edbc.</p>\\n            <p id="task-connection-status" role="status" class="hidden task-connection-status"></p>\\n            <details class="task-status-history" open>\\n              <summary>L\u1ecbch s\u1eed tr\u1ea1ng th\xe1i</summary>\\n              <ol id="task-status-history"><li>Ch\u01b0a c\xf3 ho\u1ea1t \u0111\u1ed9ng \u0111\u01b0\u1ee3c ghi nh\u1eadn.</li></ol>\\n            </details>\\n          </div>\\n          <div id="task-result" class="hidden" role="status">\\n            <p id="task-result-status" class="task-progress-detail"></p>\\n            <a id="task-result-link" class="studio-export-button hidden">Xem tr\u01b0\u1edbc k\u1ebft qu\u1ea3</a>\\n          </div>\\n        </section>\\n      </aside>\\n    </main>\\n  </div>\\n\\n  <!-- ======================================================== -->\\n  <!-- 2. TASKS VIEW (TASK MANAGER) -->\\n  <!-- ======================================================== -->\\n  <div id="view-tasks" class="app-view hidden max-w-6xl mx-auto p-6 space-y-6">\\n    <div class="flex items-center justify-between pb-3 border-b border-gray-800">\\n      <div>\\n        <h2 class="text-base font-bold text-white flex items-center gap-2">\\n          <i class="fa-solid fa-list-check text-teal-400"></i> L\u1ecbch s\u1eed video\\n        </h2>\\n        <p class="text-xs text-gray-400">M\u1ed7i video hi\u1ec7n m\u1ed9t l\u1ea7n c\xf9ng ti\u1ebfn \u0111\u1ed9 m\u1edbi nh\u1ea5t. Khi c\xf3 nhi\u1ec1u b\u1ea3n, h\u1ec7 th\u1ed1ng t\u1ef1 m\u1edf b\u1ea3n c\xf3 d\u1eef li\u1ec7u \u0111\xe3 l\u01b0u; b\u1ea3n xem tr\u01b0\u1edbc r\u1ed7ng v\u1eabn n\u1eb1m trong \u201cC\xe1c b\u1ea3n \u0111\xe3 l\u01b0u\u201d.</p>\\n      </div>\\n      <button id="btn-refresh-tasks" class="px-3 py-1.5 rounded-lg border border-gray-700 bg-gray-800 hover:bg-gray-700 text-xs text-gray-200 flex items-center gap-1.5">\\n        <i class="fa-solid fa-rotate-right"></i> L\xe0m m\u1edbi\\n      </button>\\n    </div>\\n\\n    <!-- Active Tasks Table -->\\n    <div class="history-table-container bg-[#12151f] border border-gray-800 rounded-2xl shadow-xl">\\n      <table class="history-table w-full text-left text-xs text-gray-300">\\n        <thead class="bg-gray-900/80 text-gray-400 uppercase text-[10px] border-b border-gray-800">\\n          <tr>\\n            <th class="p-3.5">Video</th>\\n            <th class="p-3.5">Tr\u1ea1ng th\xe1i &amp; Ti\u1ebfn \u0111\u1ed9</th>\\n            <th class="p-3.5">Th\u1eddi L\u01b0\u1ee3ng</th>\\n            <th class="p-3.5 text-right">Thao t\xe1c</th>\\n          </tr>\\n        </thead>\\n        <tbody id="tasks-table-body" class="divide-y divide-gray-800/60">\\n          <!-- Dynamic Task Row -->\\n          <tr>\\n            <td colspan="4" class="p-8 text-center text-gray-500 font-sans">\\n              Ch\u01b0a c\xf3 video trong l\u1ecbch s\u1eed.\\n            </td>\\n          </tr>\\n        </tbody>\\n      </table>\\n    </div>\\n  </div>\\n\\n  <!-- ======================================================== -->\\n  <!-- 3. MODELS VIEW (MODEL MANAGER) -->\\n  <!-- ======================================================== -->\\n  <div id="view-models" class="app-view hidden max-w-6xl mx-auto p-6 space-y-6">\\n    <div class="flex items-center justify-between pb-3 border-b border-gray-800">\\n      <div>\\n        <h2 class="text-base font-bold text-white flex items-center gap-2">\\n          <i class="fa-solid fa-server text-violet-400"></i> Qu\u1ea3n L\xfd Models & Checkpoints\\n        </h2>\\n        <p class="text-xs text-gray-400">Ki\u1ec3m tra t\xednh s\u1eb5n s\xe0ng, dung l\u01b0\u1ee3ng b\u1ed9 nh\u1edb v\xe0 tr\u1ea1ng th\xe1i thi\u1ebft b\u1ecb c\u1ee7a c\xe1c AI Engine.</p>\\n      </div>\\n      <button id="btn-reload-models" class="px-3 py-1.5 rounded-lg border border-gray-700 bg-gray-800 hover:bg-gray-700 text-xs text-gray-200 flex items-center gap-1.5">\\n        <i class="fa-solid fa-arrows-rotate"></i> Ki\u1ec3m tra l\u1ea1i\\n      </button>\\n    </div>\\n\\n    <div class="bg-[#12151f] border border-gray-800 rounded-2xl overflow-hidden shadow-xl">\\n      <table class="w-full text-left text-xs text-gray-300">\\n        <thead class="bg-gray-900/80 text-gray-400 uppercase text-[10px] border-b border-gray-800">\\n          <tr>\\n            <th class="p-3.5">Engine</th>\\n            <th class="p-3.5">T\xean Model / Checkpoint</th>\\n            <th class="p-3.5">K\xedch th\u01b0\u1edbc</th>\\n            <th class="p-3.5">Thi\u1ebft b\u1ecb</th>\\n            <th class="p-3.5">Tr\u1ea1ng Th\xe1i</th>\\n            <th class="p-3.5 text-right">Thao T\xe1c</th>\\n          </tr>\\n        </thead>\\n        <tbody id="models-full-table-body" class="divide-y divide-gray-800/60 font-mono">\\n          <!-- Dynamic Models populated by JS -->\\n        </tbody>\\n      </table>\\n    </div>\\n  </div>\\n\\n  <!-- ======================================================== -->\\n  <!-- 4. DIAGNOSTICS VIEW (LOG VIEWER) -->\\n  <!-- ======================================================== -->\\n  <div id="view-diagnostics" class="app-view hidden max-w-6xl mx-auto p-6 space-y-4">\\n    <div class="flex items-center justify-between pb-3 border-b border-gray-800">\\n      <div>\\n        <h2 class="text-base font-bold text-white flex items-center gap-2">\\n          <i class="fa-solid fa-terminal text-yellow-400"></i> Nh\u1eadt K\xfd & Ch\u1ea9n \u0110o\xe1n (Diagnostics)\\n        </h2>\\n        <p class="text-xs text-gray-400">Theo d\xf5i t\u1ea3i v\xe0 d\u1ecbch video \xb7 t\u1ef1 c\u1eadp nh\u1eadt m\u1ed7i 3 gi\xe2y.</p>\\n      </div>\\n      <div class="flex items-center gap-2">\\n        <button id="btn-copy-log" class="px-3 py-1.5 rounded-lg border border-gray-700 bg-gray-800 hover:bg-gray-700 text-xs text-gray-200 flex items-center gap-1.5">\\n          <i class="fa-regular fa-copy"></i> Sao ch\xe9p Log\\n        </button>\\n        <button id="btn-open-log-folder" class="px-3 py-1.5 rounded-lg border border-gray-700 bg-gray-800 hover:bg-gray-700 text-xs text-gray-200 flex items-center gap-1.5">\\n          <i class="fa-regular fa-folder-open text-pink-400"></i> M\u1edf Th\u01b0 M\u1ee5c Logs\\n        </button>\\n        <button id="btn-clear-log" class="px-3 py-1.5 rounded-lg border border-rose-800/60 bg-rose-950/40 hover:bg-rose-900/60 text-xs text-rose-300 flex items-center gap-1.5">\\n          <i class="fa-solid fa-trash-can"></i> X\xf3a Log\\n        </button>\\n      </div>\\n    </div>\\n\\n    <!-- Log Category Tabs -->\\n    <div class="flex items-center gap-2 border-b border-gray-800 pb-2">\\n      <button id="diag-warnings-tab" data-cat="warnings" class="diag-cat-btn px-3 py-1 rounded-lg text-xs font-mono text-gray-400 hover:text-white">Th\xf4ng b\xe1o t\xe1c v\u1ee5</button>\\n      <button data-cat="pipeline" class="diag-cat-btn px-3 py-1 rounded-lg text-xs font-mono font-bold bg-pink-600/80 text-white">T\xe1c v\u1ee5</button>\\n      <button data-cat="ai" class="diag-cat-btn px-3 py-1 rounded-lg text-xs font-mono text-gray-400 hover:text-white">AI</button>\\n      <button data-cat="errors" class="diag-cat-btn px-3 py-1 rounded-lg text-xs font-mono text-gray-400 hover:text-white">L\u1ed7i</button>\\n      <button data-cat="app" class="diag-cat-btn px-3 py-1 rounded-lg text-xs font-mono text-gray-400 hover:text-white">\u1ee8ng d\u1ee5ng</button>\\n      <div class="ml-auto flex items-center gap-2">\\n        <label class="text-[11px] text-gray-400 flex items-center gap-1 cursor-pointer">\\n          <input type="checkbox" id="chk-auto-scroll-log" checked class="rounded border-gray-700 text-pink-600">\\n          Theo d\xf2ng m\u1edbi\\n        </label>\\n        <button id="btn-refresh-log" aria-label="L\xe0m m\u1edbi nh\u1eadt k\xfd" title="L\xe0m m\u1edbi nh\u1eadt k\xfd" class="text-xs text-gray-400 hover:text-white p-1">\\n          <i class="fa-solid fa-arrows-rotate"></i>\\n        </button>\\n      </div>\\n    </div>\\n\\n    <section id="diagnostics-warnings-panel" aria-labelledby="diag-warnings-tab" class="hidden">\\n      <p class="text-xs text-gray-400 mb-3">Th\xf4ng b\xe1o c\u1ee7a video \u0111ang m\u1edf trong Studio, t\u1ef1 c\u1eadp nh\u1eadt theo t\xe1c v\u1ee5.</p>\\n      <p id="diagnostics-warnings-empty" class="text-sm text-gray-400">Ch\u01b0a c\xf3 th\xf4ng b\xe1o cho video \u0111ang m\u1edf.</p>\\n      <p id="pipeline-warning" role="status" class="hidden pipeline-warning"></p>\\n    </section>\\n    <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-gray-400">\\n      <p id="log-summary" role="status">Ch\u1ecdn danh m\u1ee5c \u0111\u1ec3 xem nh\u1eadt k\xfd.</p>\\n      <p id="log-copy-status" role="status" aria-live="polite"></p>\\n    </div>\\n    <!-- Log Console Output -->\\n    <div tabindex="0" aria-label="N\u1ed9i dung nh\u1eadt k\xfd" class="bg-[#07090e] border border-gray-800 rounded-2xl p-4 font-mono text-xs text-gray-300 h-[520px] overflow-y-auto leading-relaxed shadow-inner" id="log-console-output">\\n      \u0110ang t\u1ea3i log...\\n    </div>\\n  </div>\\n\\n  <!-- ======================================================== -->\\n  <!-- 5. SETTINGS VIEW (SYSTEM & ENGINE CONFIGURATION) -->\\n  <!-- ======================================================== -->\\n  <div id="view-settings" class="app-view hidden max-w-4xl mx-auto p-6 space-y-6">\\n    <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-gray-800">\\n      <div>\\n        <h2 class="text-base font-bold text-white flex items-center gap-2">\\n          <i class="fa-solid fa-gear text-cyan-400"></i> C\xe0i \u0110\u1eb7t H\u1ec7 Th\u1ed1ng & AI Engines\\n        </h2>\\n        <p class="text-xs text-gray-400">C\u1ea5u h\xecnh API d\u1ecbch thu\u1eadt, m\xf4 h\xecnh gi\u1ecdng \u0111\u1ecdc v\xe0 quy t\u1eafc l\u1ecdc \xe2m thanh.</p>\\n      </div>\\n      <button id="btn-settings-back" type="button" class="px-3 py-2 rounded-lg border border-gray-700 bg-gray-800 hover:bg-gray-700 text-xs text-gray-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400">\\n        <i class="fa-solid fa-arrow-left mr-1" aria-hidden="true"></i> Quay l\u1ea1i video\\n      </button>\\n    </div>\\n\\n    <section id="douyin-cookies-panel" aria-labelledby="douyin-cookies-heading" class="bg-[#12151f] border border-gray-800 rounded-2xl p-5 shadow-xl space-y-3">\\n      <h3 id="douyin-cookies-heading" class="text-sm font-bold text-cyan-300">T\u1ea3i video Douyin</h3>\\n      <p class="text-xs text-gray-300 leading-relaxed">D\xe1n to\xe0n b\u1ed9 n\u1ed9i dung chia s\u1ebb v\xe0o \xf4 <strong>Video ngu\u1ed3n</strong>, r\u1ed3i b\u1ea5m <strong>B\u1eaft \u0111\u1ea7u</strong>. Studio th\u1eed t\u1ea3i video c\xf4ng khai mi\u1ec5n ph\xed, kh\xf4ng c\u1ea7n API key ho\u1eb7c m\u1edf Chrome.</p>\\n      <p class="text-xs text-gray-400 leading-relaxed">Kh\u1ea3 n\u0103ng t\u1ea3i ph\u1ee5 thu\u1ed9c video v\xe0 k\u1ebft n\u1ed1i. N\u1ebfu c\xe1ch t\u1ea3i c\xf4ng khai kh\xf4ng d\xf9ng \u0111\u01b0\u1ee3c, Studio th\u1eed c\xe1ch t\u1ea3i d\u1ef1 ph\xf2ng v\xe0 cookie \u0111\xe3 nh\u1eadp n\u1ebfu c\xf3.</p>\\n      <details class="rounded-xl border border-gray-800 bg-[#08090d]/50">\\n        <summary class="cursor-pointer rounded-xl px-3 py-3 text-xs font-semibold text-gray-300 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400">N\xe2ng cao: cookie cho video c\u1ea7n \u0111\u0103ng nh\u1eadp</summary>\\n        <div class="px-3 pb-3 space-y-3">\\n          <p id="douyin-cookies-help" class="text-xs text-gray-400 leading-relaxed">Ch\u1ec9 c\u1ea7n th\u1eed c\xe1ch n\xe0y khi b\u1ed9 t\u1ea3i y\xeau c\u1ea7u phi\xean \u0111\u0103ng nh\u1eadp. Phi\xean Chrome kh\xf4ng t\u1ef1 chuy\u1ec3n sang Studio. Ch\u1ecdn t\u1ec7p Netscape cookies <span class="font-mono">.txt</span> ch\u1ec9 xu\u1ea5t t\u1eeb Douyin sau khi \u0111\u0103ng nh\u1eadp (t\u1ed1i \u0111a 1 MiB). B\u1ea3n sao \u0111\u01b0\u1ee3c l\u01b0u tr\xean m\xe1y v\xe0 ch\u1ec9 d\xf9ng \u0111\u1ec3 t\u1ea3i video Douyin.</p>\\n          <p id="douyin-cookies-state" class="text-xs text-gray-300">Ch\u01b0a ki\u1ec3m tra cookie \u0111\xe3 nh\u1eadp.</p>\\n          <div class="flex flex-wrap items-center gap-2">\\n            <input id="douyin-cookies-file" type="file" accept=".txt,text/plain" aria-label="Ch\u1ecdn t\u1ec7p cookie Douyin" aria-describedby="douyin-cookies-help" class="hidden">\\n            <button id="btn-import-douyin-cookies" type="button" class="px-3 py-2 rounded-xl border border-cyan-500/50 hover:bg-cyan-600/20 text-cyan-300 text-xs font-semibold transition disabled:opacity-50 disabled:cursor-not-allowed">Nh\u1eadp cookie t\u1eeb t\u1ec7p\u2026</button>\\n            <button id="btn-refresh-douyin-cookies" type="button" class="px-3 py-2 rounded-xl border border-gray-700 hover:bg-gray-800 text-gray-300 text-xs font-semibold transition disabled:opacity-50 disabled:cursor-not-allowed">Ki\u1ec3m tra tr\u1ea1ng th\xe1i</button>\\n            <button id="btn-delete-douyin-cookies" type="button" disabled class="px-3 py-2 rounded-xl border border-gray-700 hover:bg-rose-900/20 text-rose-300 text-xs font-semibold transition disabled:opacity-50 disabled:cursor-not-allowed">X\xf3a cookie \u0111\xe3 nh\u1eadp</button>\\n          </div>\\n          <p id="douyin-cookies-status" role="status" aria-live="polite" aria-atomic="true" class="text-xs text-gray-400 leading-relaxed">Nh\u1eadp cookie ch\u01b0a x\xe1c nh\u1eadn t\u1ea3i \u0111\u01b0\u1ee3c video; c\u1ea7n ch\u1ea1y l\u1ea1i link Douyin \u0111\u1ec3 ki\u1ec3m tra.</p>\\n        </div>\\n      </details>\\n    </section>\\n\\n    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">\\n      \\n      <!-- AI Translation Settings -->\\n      <div class="bg-[#12151f] border border-gray-800 rounded-2xl p-5 shadow-xl space-y-4">\\n        <h3 class="text-xs font-bold text-pink-400 uppercase tracking-wider flex items-center gap-2">\\n          <i class="fa-solid fa-language"></i> 1. AI D\u1ecbch Thu\u1eadt (Translation)\\n        </h3>\\n\\n        <div>\\n          <label class="text-xs text-gray-300 block mb-1">Nh\xe0 cung c\u1ea5p (LLM Provider):</label>\\n          <select id="settings-llm-provider" class="w-full bg-[#08090d] border border-gray-700 rounded-xl px-3 py-2 text-xs text-gray-100 focus:outline-none focus:border-pink-500">\\n            <option value="openrouter-free" >OpenRouter Free (mi\u1ec5n ph\xed)</option>\\n            <option value="ollama" selected>Ollama local \xb7 Qwen2.5 7B</option>\\n            <option value="gemini" >Google Gemini (t\xf9y ch\u1ecdn, c\u1ea7n key)</option>\\n            <option value="deepseek">DeepSeek AI (V\u0103n phong k\u1ecbch t\xednh)</option>\\n            <option value="openai">OpenAI Compatible API</option>\\n            <option value="free">Google / MyMemory mi\u1ec5n ph\xed</option>\\n            <option value="opencode" >OpenCode Zen \xb7 Muse Spark Free</option>\\n            <option value="muse">Muse qua Chrome (th\u1eed nghi\u1ec7m, t\xe0i kho\u1ea3n Meta)</option>\\n          </select>\\n        </div>\\n\\n        <div>\\n          <div class="flex items-center justify-between mb-1">\\n            <label class="text-xs text-gray-300">Google Gemini API Key:</label>\\n            <span class="text-[10px] text-gray-500">L\u01b0u an to\xe0n t\u1ea1i .env</span>\\n          </div>\\n          <div class="relative">\\n            <input type="password" id="settings-gemini-key" placeholder="AIzaSy..." class="w-full bg-[#08090d] border border-gray-700 rounded-xl pl-3 pr-10 py-2 text-xs text-gray-100 focus:outline-none focus:border-pink-500 font-mono">\\n            <button type="button" id="btn-toggle-gemini-key" class="absolute right-3 top-2.5 text-gray-500 hover:text-gray-300">\\n              <i class="fa-regular fa-eye text-xs"></i>\\n            </button>\\n          </div>\\n        </div>\\n\\n        <div>\\n          <label class="text-xs text-gray-300 block mb-1">Gemini Model:</label>\\n          <input id="settings-gemini-model" list="gemini-model-options" value="gemini-2.5-flash" placeholder="T\xean model Gemini" class="w-full bg-[#08090d] border border-gray-700 rounded-xl px-3 py-2 text-xs text-gray-100 focus:outline-none focus:border-pink-500">\\n          <datalist id="gemini-model-options">\\n            <option value="gemini-2.5-flash">\u01afu ti\xean tr\xean m\xe1y n\xe0y \u2014 \u0111\xe3 ki\u1ec3m tra d\u1ecbch</option>\\n            <option value="gemini-3.6-flash">Flash 3.6 \u2014 c\xf3 th\u1ec3 th\u1eed khi h\u1ebft qu\xe1 t\u1ea3i</option>\\n            <option value="gemini-3.8-flash">Flash m\u1edbi nh\u1ea5t \u2014 c\xf3 th\u1ec3 th\u1eed khi c\xf2n c\xf4ng su\u1ea5t</option>\\n            <option value="gemini-3.7-flash">Flash th\u1ebf h\u1ec7 tr\u01b0\u1edbc</option>\\n            <option value="gemini-3.5-flash">Flash 3.5</option>\\n            <option value="gemini-3.1-pro-preview">Pro \u2014 c\u1ea7n quota ph\xf9 h\u1ee3p</option>\\n          </datalist>\\n          <p class="text-[11px] text-gray-500 mt-2">L\u01b0u c\u1ea5u h\xecnh tr\u01b0\u1edbc khi ki\u1ec3m tra. Ch\u1ea5t l\u01b0\u1ee3ng, t\u1ed1c \u0111\u1ed9 v\xe0 h\u1ea1n m\u1ee9c ph\u1ee5 thu\u1ed9c model v\xe0 t\xe0i kho\u1ea3n.</p>\\n        </div>\\n\\n        <!-- Gemini Test Connection Button & Result -->\\n        <div class="pt-2 flex items-center justify-between">\\n          <button id="btn-test-gemini" class="px-3 py-1.5 rounded-xl border border-pink-500/50 hover:bg-pink-600/20 text-pink-300 text-xs font-semibold flex items-center gap-1.5 transition">\\n            <i class="fa-solid fa-plug-circle-check"></i> Ki\u1ec3m tra k\u1ebft n\u1ed1i Gemini\\n          </button>\\n          <span id="gemini-test-result" class="text-xs font-mono text-gray-400"></span>\\n        </div>\\n\\n        <div class="rounded-xl border border-pink-500/30 p-3 space-y-2">\\n          <label for="settings-openrouter-model" class="text-xs text-gray-300 block">Model OpenRouter Free:</label>\\n          <input id="settings-openrouter-model" value="inclusionai/ling-3.0-flash-sante:free" class="w-full bg-[#08090d] border border-gray-700 rounded-xl px-3 py-2 text-xs text-gray-100 focus:outline-none focus:border-pink-500">\\n          <p id="openrouter-auth-status" role="status" class="text-xs text-gray-400">\u0110ang ki\u1ec3m tra key\u2026</p>\\n          <p class="text-[11px] text-gray-500">T\u1ef1 d\xf9ng key OpenRouter Free trong OpenCode. Ch\u1ec9 nh\u1eadn model c\xf3 \u0111u\xf4i :free; c\u1ea7n Internet v\xe0 c\xf3 gi\u1edbi h\u1ea1n l\u01b0\u1ee3t d\xf9ng.</p>\\n          <button type="button" id="btn-test-openrouter" class="px-3 py-1.5 rounded-xl border border-pink-500/50 hover:bg-pink-600/20 text-pink-300 text-xs font-semibold transition">Ki\u1ec3m tra OpenRouter Free</button>\\n          <span id="openrouter-test-result" role="status" class="block text-xs text-gray-400"></span>\\n        </div>\\n\\n        <details class="rounded-xl border border-gray-700 p-3 space-y-2">\\n          <summary class="text-xs text-gray-300 cursor-pointer">OpenCode Zen \xb7 Muse Spark Free</summary>\\n          <label for="settings-opencode-model" class="text-xs text-gray-300 block">Model OpenCode Free:</label>\\n          <select id="settings-opencode-model" class="w-full bg-[#08090d] border border-gray-700 rounded-xl px-3 py-2 text-xs text-gray-100 focus:outline-none focus:border-pink-500">\\n            <option value="muse-spark-1.3-contributor-free">muse-spark-1.3-contributor-free</option>\\n          </select>\\n          <p id="opencode-auth-status" role="status" class="text-xs text-gray-400">\u0110ang ki\u1ec3m tra key OpenCode tr\xean m\xe1y\u2026</p>\\n          <p class="text-[11px] text-gray-500">D\xf9ng model mi\u1ec5n ph\xed qua OpenCode \u0111\xe3 \u0111\u0103ng nh\u1eadp tr\xean m\xe1y, kh\xf4ng c\u1ea7n Chrome. N\u1ebfu d\u1ecbch v\u1ee5 t\u1eeb ch\u1ed1i ho\u1eb7c h\u1ebft h\u1ea1n m\u1ee9c, t\xe1c v\u1ee5 b\xe1o l\u1ed7i v\xe0 gi\u1eef nguy\xean nh\xe0 cung c\u1ea5p \u0111\xe3 ch\u1ecdn.</p>\\n          <button type="button" id="btn-test-opencode" class="px-3 py-1.5 rounded-xl border border-pink-500/50 hover:bg-pink-600/20 text-pink-300 text-xs font-semibold transition">Ki\u1ec3m tra k\u1ebft n\u1ed1i OpenCode</button>\\n          <span id="opencode-test-result" role="status" class="block text-xs text-gray-400"></span>\\n        </details>\\n\\n        <div>\\n          <label for="settings-translation-workers" class="text-xs text-gray-300 block mb-1">Lu\u1ed3ng d\u1ecbch song song</label>\\n          <select id="settings-translation-workers" aria-describedby="settings-translation-workers-help" class="w-full bg-[#08090d] border border-gray-700 rounded-xl px-3 py-2 text-xs text-gray-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pink-500">\\n            \\n            <option value="1" selected>1 lu\u1ed3ng</option>\\n            \\n            <option value="3" >3 lu\u1ed3ng</option>\\n            \\n            <option value="5" >5 lu\u1ed3ng</option>\\n            \\n            <option value="10" >10 lu\u1ed3ng</option>\\n            \\n            <option value="15" >15 lu\u1ed3ng</option>\\n            \\n            <option value="20" >20 lu\u1ed3ng</option>\\n            \\n            <option value="30" >30 lu\u1ed3ng</option>\\n            \\n            <option value="40" >40 lu\u1ed3ng</option>\\n            \\n            <option value="50" >50 lu\u1ed3ng</option>\\n            \\n          </select>\\n          <p id="settings-translation-workers-help" class="text-[11px] text-gray-400 mt-1">S\u1ed1 y\xeau c\u1ea7u d\u1ecbch v\xe0 ki\u1ec3m tra AI \u0111\u1ed3ng th\u1eddi t\u1ed1i \u0111a cho m\u1ed7i video. M\u1eb7c \u0111\u1ecbnh 20; c\xf3 th\u1ec3 ch\u1ecdn 30, 40 ho\u1eb7c 50. Nh\u1eadn gi\u1ecdng, t\u1ea1o gi\u1ecdng v\xe0 d\u1ef1ng video d\xf9ng gi\u1edbi h\u1ea1n ri\xeang.</p>\\n        </div>\\n\\n        <div class="border-t border-gray-800 pt-3">\\n          <label class="text-xs text-gray-300 block mb-1">DeepSeek API Key (T\xf9y ch\u1ecdn):</label>\\n          <input type="password" id="settings-deepseek-key" placeholder="sk-..." class="w-full bg-[#08090d] border border-gray-700 rounded-xl px-3 py-2 text-xs text-gray-100 focus:outline-none focus:border-pink-500 font-mono">\\n        </div>\\n\\n        <details class="rounded-xl border border-gray-700 p-3 space-y-3">\\n          <summary class="text-xs text-gray-300 cursor-pointer">Muse qua t\xe0i kho\u1ea3n Meta (th\u1eed nghi\u1ec7m)</summary>\\n          <p class="text-xs text-gray-400">K\u1ebft n\u1ed1i phi\xean Muse \u0111\xe3 \u0111\u0103ng nh\u1eadp trong Chrome c\u1ee7a b\u1ea1n ho\u1eb7c d\xf9ng Chrome ri\xeang. H\u1ea1n m\u1ee9c v\xe0 model ph\xeda sau do Muse quy\u1ebft \u0111\u1ecbnh.</p>\\n          <label for="settings-muse-browser-mode" class="text-xs text-gray-300 block">Phi\xean Chrome cho Muse</label>\\n          <select id="settings-muse-browser-mode" class="w-full bg-[#08090d] border border-gray-700 rounded-xl px-3 py-2 text-xs text-gray-100 focus:outline-none focus:border-pink-500">\\n            <option value="existing">Chrome \u0111ang d\xf9ng \u2014 gi\u1eef phi\xean Muse \u0111\xe3 \u0111\u0103ng nh\u1eadp</option>\\n            <option value="dedicated">Chrome ri\xeang c\u1ee7a tool \u2014 \u0111\u0103ng nh\u1eadp m\u1ed9t l\u1ea7n</option>\\n          </select>\\n          <p class="text-xs text-gray-400">L\u01b0u c\u1ea5u h\xecnh tr\u01b0\u1edbc khi k\u1ebft n\u1ed1i. V\u1edbi Chrome \u0111ang d\xf9ng, m\u1edf <code>chrome://inspect/#remote-debugging</code>, b\u1eadt <strong>Allow remote debugging for this browser instance</strong>, r\u1ed3i cho ph\xe9p khi Chrome h\u1ecfi k\u1ebft n\u1ed1i. Quy\u1ec1n n\xe0y cho \u1ee9ng d\u1ee5ng local \u0111i\u1ec1u khi\u1ec3n tr\xecnh duy\u1ec7t; tool ch\u1ec9 thao t\xe1c tab Muse do n\xf3 m\u1edf. C\xf3 th\u1ec3 t\u1eaft l\u1ea1i sau khi d\xf9ng.</p>\\n          <p id="muse-status" role="status" class="text-xs text-gray-400">\u0110ang ki\u1ec3m tra c\xe0i \u0111\u1eb7t Muse\u2026</p>\\n          <div class="flex flex-wrap gap-2">\\n            <button type="button" id="btn-muse-login" class="px-3 py-2 rounded-xl border border-pink-500/50 hover:bg-pink-600/20 text-pink-300 text-xs">K\u1ebft n\u1ed1i Muse</button>\\n            <button type="button" id="btn-muse-status" class="px-3 py-2 rounded-xl border border-gray-700 hover:bg-gray-800 text-gray-300 text-xs">Ki\u1ec3m tra \u0111\u0103ng nh\u1eadp</button>\\n            <button type="button" id="btn-test-muse" class="px-3 py-2 rounded-xl border border-gray-700 hover:bg-gray-800 text-gray-300 text-xs">Th\u1eed d\u1ecbch Muse</button>\\n          </div>\\n        </details>\\n      </div>\\n\\n      <!-- Voice & Audio Settings -->\\n      <div class="bg-[#12151f] border border-gray-800 rounded-2xl p-5 shadow-xl space-y-4">\\n        <h3 class="text-xs font-bold text-violet-400 uppercase tracking-wider flex items-center gap-2">\\n          <i class="fa-solid fa-headphones"></i> 2. \xc2m Thanh & T\xe1ch Gi\u1ecdng\\n        </h3>\\n\\n        <div>\\n          <label class="text-xs text-gray-300 block mb-1">Engine T\xe1ch Tho\u1ea1i Realtime:</label>\\n          <select id="settings-suppression-mode" class="w-full bg-[#08090d] border border-gray-700 rounded-xl px-3 py-2 text-xs text-gray-100 focus:outline-none focus:border-pink-500">\\n            <option value="AUTO" selected>T\u1ef1 \u0111\u1ed9ng nh\u1eadn di\u1ec7n (Stereo Cancel ho\u1eb7c Formant Notch - Khuy\xean d\xf9ng)</option>\\n            <option value="DSP_MONO_ADAPTIVE_FORMANT">\u0110\u01a1n k\xeanh: Multi-band Formant Notch (-20dB)</option>\\n            <option value="DSP_STEREO_CENTER_CANCEL">\u0110a k\xeanh: Mid-Side Phase Cancel (-26dB)</option>\\n          </select>\\n        </div>\\n\\n        <div>\\n          <label class="text-xs text-gray-300 block mb-1">Engine Xu\u1ea5t Video Ho\xe0n Ch\u1ec9nh (HQ):</label>\\n          <select class="w-